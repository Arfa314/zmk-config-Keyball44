#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt { flavor = "balanced"; };

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

&sl { release-after-ms = <500>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        test2: test2 {
            compatible = "zmk,behavior-sticky-key";
            label = "TEST2";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <500>;
        };

        spacenum: spacenum {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACENUM";
            bindings = <&mo>, <&SPACE_SL>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        new_space: new_space {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_SPACE";
            bindings = <&mo>, <&SPACE_SL>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        sem: sem {
            compatible = "zmk,behavior-tap-dance";
            label = "SEM";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp COMMA>;
        };

        shiftkeyboard: shiftkeyboard {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTKEYBOARD";
            #binding-cells = <0>;
            bindings = <&lt 2 SPACE>, <&tog 2>;
        };

        doubleL5: doubleL5 {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLEL5";
            #binding-cells = <0>;
            bindings = <&lt 5 SPACE>, <&tog 2>;
        };

        spacetype: spacetype {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACETYPE";
            bindings = <&lt>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        full_type_mode: full_type_mode {
            compatible = "zmk,behavior-tap-dance";
            label = "FULL_TYPE_MODE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN>, <&tog 2>;
        };

        // Thumb space: hold = momentary layer, tap = SPACE + arm &sl 1.
        // tap-preferred so a fast letter after the space can never steal the
        // space and drop you onto the hold layer instead.
        //
        // Deliberately NO quick-tap-ms here: quick-tap forces a second tap when
        // you re-press within the window, which would turn "space, then hold for
        // SYM" into two spaces -- i.e. it would break typing "a && b".

        spc_lt: spc_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPC_LT";
            bindings = <&mo>, <&SPACE_SL>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        // Same, but taps KP_ENTER + arms &sl 1.

        ent_lt: ent_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "ENT_LT";
            bindings = <&mo>, <&ENTER_SL>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        // Esc / Backspace / Delete are deliberately plain &kp, NOT _SL macros
        // and not hold-taps: they fire on press (no hold-tap release latency),
        // they get native OS auto-repeat, and they do not arm &sl 1 -- so you
        // stay on layer 0 and the mouse buttons are live straight after them.
        // Trade-off: typing j/k/l immediately after one of these will click.
        // ESC_SL / BK_SL / DEL_SL are kept below if you want to swap back.
    };

    combos {
        compatible = "zmk,combos";

        // `layers` keeps these off SYM / NUM / FUN / SCROLL / SNIPE. ZMK matches
        // against the *highest* active layer, so every layer you may toggle
        // from has to be listed here.

        TypingMode {
            bindings = <&tog 2>;
            key-positions = <42 38>;
            layers = <0 1 2 3 9>;
            timeout-ms = <40>;
        };

        onehandmode {
            bindings = <&tog 3>;
            key-positions = <43 41>;
            layers = <0 1 2 3 9>;
            timeout-ms = <30>;
        };

        // NOTE: &bootloader must NOT be put on a combo. It is
        // BEHAVIOR_LOCALITY_EVENT_SOURCE (it resets the half the key physically
        // lives on), but combos invoke their binding with a *virtual* key
        // position, which bypasses split routing -- a combo'd &bootloader can
        // only ever reset the central (right) half. Left-half reset therefore
        // has to stay a plain binding on a left-half key. See the RESET layer.
    };

    macros {
        SPACE_SL: SPACE_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &sl 1>;
            label = "&SPACE_SL";
        };

        Q_SL: Q_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &sl 1>;
            label = "Q_SL";
        };

        W_SL: W_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &sl 1>;
            label = "W_SL";
        };

        E_SL: E_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &sl 1>;
            label = "E_SL";
        };

        R_SL: R_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &sl 1>;
            label = "R_SL";
        };

        T_SL: T_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &sl 1>;
            label = "T_SL";
        };

        A_SL: A_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &sl 1>;
            label = "A_SL";
        };

        B_SL: B_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &sl 1>;
            label = "B_SL";
        };

        C_SL: C_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &sl 1>;
            label = "C_SL";
        };

        BK_SL: BK_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE &sl 1>;
            label = "BK_SL";
        };

        DEL_SL: DEL_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE &sl 1>;
            label = "DEL_SL";
        };

        J_SL: J_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp J &sl 1>;
            label = "J_SL";
        };

        K_SL: K_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &sl 1>;
            label = "K_SL";
        };

        L_SL: L_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &sl 1>;
            label = "L_SL";
        };

        O_SL: O_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &sl 1>;
            label = "O_SL";
        };

        P_SL: P_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &sl 1>;
            label = "P_SL";
        };

        H_SL: H_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &sl 1>;
            label = "H_SL";
        };

        U_SL: U_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &sl 1>;
            label = "U_SL";
        };

        Y_SL: Y_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &sl 1>;
            label = "Y_SL";
        };

        I_SL: I_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &sl 1>;
            label = "I_SL";
        };

        S_SL: S_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &sl 1>;
            label = "S_SL";
        };

        V_SL: V_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &sl 1>;
            label = "V_SL";
        };

        M_SL: M_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &sl 1>;
            label = "M_SL";
        };

        N_SL: N_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &sl 1>;
            label = "N_SL";
        };

        D_SL: D_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &sl 1>;
            label = "D_SL";
        };

        F_SL: F_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &sl 1>;
            label = "F_SL";
        };

        G_SL: G_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &sl 1>;
            label = "G_SL";
        };

        Z_SL: Z_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &sl 1>;
            label = "Z_SL";
        };

        X_SL: X_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &sl 1>;
            label = "X_SL";
        };

        // Non-letter keys that occur inside a typing flow must arm &sl 1 too,
        // otherwise the next j/k/l falls through to layer 0 and clicks.

        ESC_SL: ESC_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &sl 1>;
            label = "ESC_SL";
        };

        SEMI_SL: SEMI_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON &sl 1>;
            label = "SEMI_SL";
        };

        DOT_SL: DOT_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &sl 1>;
            label = "DOT_SL";
        };

        SLASH_SL: SLASH_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SLASH &sl 1>;
            label = "SLASH_SL";
        };

        ENTER_SL: ENTER_SL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_ENTER &sl 1>;
            label = "ENTER_SL";
        };

        // DIAGNOSTIC (temporary): types & the way a human does -- shift down,
        // pause, tap 7, pause, shift up -- instead of &kp LS(N7), which puts
        // the modifier and the key in a single HID report. If this works where
        // &kp LS(NUMBER_7) does not, the problem is report timing on the host.

        AMP: AMP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "AMP";
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_wait_time 30>
                , <&macro_tap_time 30>
                , <&macro_tap &kp N7>
                , <&macro_wait_time 30>
                , <&macro_release &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "MOS+TYPE";
            bindings = <
&kp ESC           &Q_SL           &W_SL         &E_SL          &R_SL          &T_SL                     &Y_SL          &U_SL      &I_SL      &O_SL      &P_SL     &kp BACKSPACE
&lt 8 TAB         &A_SL           &S_SL         &D_SL          &F_SL          &G_SL                     &H_SL          &mkp LCLK  &mkp MCLK  &mkp RCLK  &SEMI_SL  &kp DEL
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &Z_SL         &X_SL          &C_SL          &V_SL                     &B_SL          &N_SL      &M_SL      &DOT_SL    &SLASH_SL &kp RIGHT_SHIFT
&full_type_mode   &kp LEFT_WIN    &kp LEFT_ALT  &spc_lt 9 0    &spc_lt 5 0               &spc_lt 4 0    &spc_lt 7 0                                                &ent_lt 6 0
            >;
        };

        TRANS_LAYER {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &J_SL   &K_SL   &L_SL   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;

            label = "QWRT-TYPE";
        };

        FULL_TYPE {
            label = "TYPING_ONLY";
            bindings = <
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T              &kp Y   &kp U  &kp I  &kp O   &kp P   &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G              &kp H   &kp J  &kp K  &kp L   &trans  &trans
&trans  &trans  &kp Z   &kp X   &kp C   &kp V              &kp B   &kp N  &kp M  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans             &trans  &trans                                &trans
            >;
        };

        onehandmode {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                   &trans  &trans     &trans     &trans     &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &lt 5 PERIOD  &trans
&trans  &trans  &trans  &trans  &trans  &trans                   &trans  &trans     &trans     &trans     &trans        &trans
&trans  &trans  &trans  &trans  &trans              &lt 8 SPACE  &trans                                                 &trans
            >;

            label = "onehandmode";
        };

        function_layer {
            label = "FUN";
            bindings = <
&none        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC              &kp INSERT  &kp F7  &kp F8  &kp F9  &kp F10  &none
&kp CAPS     &none              &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2          &out OUT_TOG                      &none       &kp F4  &kp F5  &kp F6  &kp F11  &none
&none        &none              &none            &none         &none                 &none                             &none       &kp F1  &kp F2  &kp F3  &kp F12  &none
&none        &trans             &trans           &trans        &trans                                          &trans  &trans                                       &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &kp HOME  &kp PG_UP  &kp UP    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans    &kp LEFT   &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &kp END   &kp PG_DN  &trans    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                            &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans       &trans  &trans        &trans        &trans        &trans              &trans  &trans     &trans     &trans     &trans  &trans
&trans       &trans  &trans        &trans        &trans        &trans              &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans       &trans  &trans        &trans        &trans        &trans              &trans  &trans     &trans     &trans     &trans  &trans
&trans       &trans  &trans        &trans        &trans                    &trans  &trans                                           &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp TILDE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR       &kp PERCENT               &kp CARET       &kp LS(NUMBER_7)  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LS(NUMBER_7)
&trans     &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp RIGHT_BRACE  &AMP                      &kp MINUS       &kp EQUAL         &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp COMMA              &trans
&trans     &trans            &trans             &trans          &trans           &kp PIPE                  &kp UNDERSCORE  &kp PLUS          &kp LESS_THAN     &kp GREATER_THAN      &kp NON_US_BACKSLASH   &trans
&trans     &trans            &trans             &trans          &trans                             &trans  &trans                                                                                           &trans
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &kp KP_PLUS  &kp N7  &kp N8  &kp N9  &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &kp MINUS    &kp N4  &kp N5  &kp N6  &kp EQUAL     &trans
&trans  &trans  &trans  &trans  &trans  &trans              &kp PERIOD   &kp N1  &kp N2  &kp N3  &kp SLASH     &trans
&trans  &trans  &trans  &trans  &trans              &trans  &kp N0                                             &trans
            >;
        };

        // Identical to TRANS_LAYER, but reached by *holding* the left thumb
        // space. It has to be a separate index: ZMK layer state is a plain
        // bitmask with no refcount, so if the hold and the sticky key both
        // targeted layer 1 the sticky's release would switch the layer off
        // underneath the held key.

        MOUSE_OFF {
            label = "HOLD-TYPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &J_SL   &K_SL   &L_SL   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };

        // Reached by holding the inner two RIGHT thumbs (pos 41 -> FUN and
        // pos 42 -> SYM) for 150ms, via the conditional layer at the bottom.
        //
        // Esc (pos 0) is on the LEFT half and Backspace (pos 11) on the RIGHT,
        // so each one resets its own side -- &bootloader runs on the half the
        // key physically belongs to. Because both trigger thumbs are right-half
        // keys, the RIGHT bootloader needs nothing from the left half.
        //
        // The LEFT bootloader cannot be made independent: a ZMK peripheral does
        // not run the keymap at all, so any keyboard-driven reset of the left
        // half needs the right half alive to resolve the binding and route it.
        // If the right half is dead, the left half's only reset is the physical
        // button under the OLED cover.
        //
        // BT_CLR is central-locality, so it is put on the right half too.

        RESET {
            label = "RESET";
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans              &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Both trigger layers are on the RIGHT half on purpose (pos 41 = FUN,
        // pos 42 = SYM). The right half is the central and runs standalone, so
        // its bootloader must never depend on the left half being alive.

        reset_layer {
            if-layers = <4 7>;
            then-layer = <10>;
        };
    };
};
